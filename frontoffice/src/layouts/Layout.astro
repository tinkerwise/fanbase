---
import { statSync } from 'node:fs';
import path from 'node:path';
import { TEAM_CONFIG, LEGACY_ABBR } from '../scripts/teamConfig.js';

interface Props {
  title?: string;
  teamId?: number;
}
const { title = 'Front Office', teamId } = Astro.props;

const teamColors = Object.fromEntries(
  Object.values(TEAM_CONFIG).map(t => [t.id, [t.color, t.colorDark ?? t.color, t.abbr]])
);
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;

const NAV = [
  { href: base, label: 'Home', icon: 'home' },
  { href: `${base}league/`, label: 'League', icon: 'league' },
];

const NAV_ICONS: Record<string, string> = {
  home: '<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  league: '<circle cx="12" cy="12" r="9"/><path d="M3.6 9h16.8M3.6 15h16.8M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  team: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  settings: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
  fanbase: '<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/><path d="M9 21V12h6v9"/>',
};

const stylePath = path.join(process.cwd(), 'public', 'style.css');
const styleVersion = Math.floor(statSync(stylePath).mtimeMs);

function isActive(href: string) {
  if (href === base) return pathname === base;
  return pathname.startsWith(href);
}
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="MLB Front Office Intelligence — GMs, transactions, payroll, and draft data for all 30 teams." />
    <title>{title} | Front Office</title>
    <link rel="icon" type="image/jpeg" href={`${base}favicon.jpg`} />
    <link rel="stylesheet" href={`${base}style.css?v=${styleVersion}`} />
    <!-- Team accent colors — same contrast logic as Fanbase -->
    <script is:inline define:vars={{ teamColors, legacyAbbr: LEGACY_ABBR, defaultId: teamId ?? 110 }}>
      (function () {
        var root = document.documentElement;
        function rgb(hex) { return [1,3,5].map(function(i){ return parseInt(hex.slice(i,i+2),16); }); }
        function lum(c) { var v=c.map(function(x){x/=255;return x<=0.03928?x/12.92:Math.pow((x+0.055)/1.055,2.4);}); return 0.2126*v[0]+0.7152*v[1]+0.0722*v[2]; }
        function contrast(a,b){var la=lum(a),lb=lum(b);return(Math.max(la,lb)+0.05)/(Math.min(la,lb)+0.05);}
        function ensure(c,bg,ratio,toward){for(var t=0;t<=1.0001;t+=0.05){var m=c.map(function(x,i){return Math.round(x+(toward[i]-x)*t);});if(contrast(m,bg)>=ratio)return m;}return toward;}
        function onColor(c){return contrast(c,[255,255,255])>contrast(c,[16,24,32])?'#ffffff':'#101820';}
        function vars(hex,bg,toward){var fill=ensure(rgb(hex),bg,3,toward),text=ensure(rgb(hex),bg,4.5,toward);return'{--accent:rgb('+fill+');--accent-text:rgb('+text+');--accent-rgb:'+fill+';--accent-dim:rgba('+fill+',0.13);--on-accent:'+onColor(fill)+'}';}
        var WHITE=[255,255,255],BLACK=[0,0,0];
        // Resolve team from localStorage or URL, fallback to defaultId
        var params=new URLSearchParams(location.search);
        var saved=null;try{saved=Number(localStorage.getItem('fo_team'))||null;}catch(e){}
        function find(q){q=String(q||'').trim().toUpperCase();if(!q)return null;if(teamColors[q])return Number(q);for(var k in teamColors)if(teamColors[k][2]===q)return Number(k);return legacyAbbr[q]||null;}
        var urlTeam=find(params.get('team'));
        if(urlTeam)try{localStorage.setItem('fo_team',String(urlTeam));}catch(e){}
        var id=urlTeam||saved||defaultId;
        var theme='dark';try{theme=localStorage.getItem('fo_theme')||'dark';}catch(e){}
        root.setAttribute('data-theme',theme);
        var tc=teamColors[id];
        if(tc){
          var css=':root'+vars(tc[1],[23,23,23],WHITE)+'[data-theme="light"]'+vars(tc[0],[245,245,245],BLACK);
          var s=document.createElement('style');s.id='teamAccent';s.textContent=css;document.head.appendChild(s);
        }
      })();
    </script>
  </head>
  <body>
    <!-- Site header -->
    <header class="site-header">
      <a class="header-logo" href={base}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="7" width="20" height="14" rx="2"/>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
        </svg>
        <span>
          Front<strong style="color:var(--accent)">Office</strong>
          <span class="header-logo-sub">MLB Intelligence</span>
        </span>
      </a>
      <div class="header-right">
        <!-- Theme toggle -->
        <div class="theme-btn-wrap" id="themeToggle">
          <button class="theme-btn" data-theme-set="dark">Dark</button>
          <button class="theme-btn" data-theme-set="light">Light</button>
        </div>
        <!-- Back to Fanbase -->
        <a class="btn-icon" href="https://www.briancsmith.org/fanbase/" title="Back to Fanbase" style="gap:5px;width:auto;padding:0 8px;font-size:.78rem;color:var(--text-2)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={NAV_ICONS.fanbase}/>
          Fanbase
        </a>
      </div>
    </header>

    <!-- Page wrapper: side nav + main -->
    <div class="page-wrap">
      <nav class="side-nav" aria-label="Front Office navigation">
        <div class="nav-section">
          <div class="nav-section-label">Pages</div>
          {NAV.map(l => (
            <a href={l.href} class={`nav-link${isActive(l.href) ? ' active' : ''}`}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={NAV_ICONS[l.icon]}/>
              {l.label}
            </a>
          ))}
        </div>
        <div class="nav-section" id="teamNavSection">
          <div class="nav-section-label">Teams</div>
          <!-- Populated by client JS from teamConfig -->
        </div>
      </nav>

      <div class="main-content">
        <slot />
      </div>
    </div>

    <footer class="site-footer">
      Front Office · Data via <a href="https://statsapi.mlb.com" target="_blank" rel="noopener">MLB Stats API</a> &amp; Google News RSS ·
      <a href="https://www.briancsmith.org/fanbase/">Back to Fanbase</a>
    </footer>

    <!-- Theme toggle JS + nav team links -->
    <script is:inline define:vars={{ base }}>
      (function () {
        // Theme buttons
        var root = document.documentElement;
        var wrap = document.getElementById('themeToggle');
        if (wrap) {
          function setTheme(t) {
            root.setAttribute('data-theme', t);
            try { localStorage.setItem('fo_theme', t); } catch(e) {}
            wrap.querySelectorAll('[data-theme-set]').forEach(function(btn) {
              btn.classList.toggle('active', btn.dataset.themeSet === t);
            });
          }
          var cur = root.getAttribute('data-theme') || 'dark';
          setTheme(cur);
          wrap.addEventListener('click', function(e) {
            var btn = e.target.closest('[data-theme-set]');
            if (btn) setTheme(btn.dataset.themeSet);
          });
        }
      })();
    </script>
    <script>
      import '../scripts/navTeams.js';
    </script>
  </body>
</html>
