---
import { statSync } from 'node:fs';
import path from 'node:path';
import { TEAM_CONFIG, LEGACY_ABBR } from '../scripts/teamConfig.js';
import SettingsPanel from '../components/SettingsPanel.astro';

interface Props {
  title?: string;
}
const { title = 'Fanbase' } = Astro.props;
// id → [light-theme color, dark-theme color, abbr] for the head script below
const teamColors = Object.fromEntries(
  Object.values(TEAM_CONFIG).map(t => [t.id, [t.color, t.colorDark ?? t.color, t.abbr]])
);
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
// One list, three menus: the desktop row (icon + label, moved below the
// header by the script after <slot />), the bottom tab bar on phones and
// tablets (`tab`), and its More sheet (everything else). Groups: today,
// your team, league-wide events; a divider separates them on desktop.
// Dugout is the news page (/dugout/; /news/ redirects); Roster is the
// depth-chart page (field, rotation, bullpen, injured list).
// Front Office (#14) holds Trades and Draft: they're off the desktop row
// (`desktop: false`, reached from the Front Office page and Home's sidebar
// group) and indented under it in More (`parent`). Front Office counts as
// the current page while on them (`covers`).
const NAV_LINKS = [
  { href: base, label: 'Home', icon: 'home', group: 'today', tab: true },
  { href: `${base}dugout/`, label: 'Dugout', icon: 'dugout', group: 'today', tab: true },
  { href: `${base}schedule/`, label: 'Schedule', icon: 'schedule', group: 'team', tab: true },
  { href: `${base}depth-chart/`, label: 'Roster', icon: 'roster', group: 'team', tab: true },
  { href: `${base}front-office/`, label: 'Front Office', icon: 'frontOffice', group: 'team', covers: [`${base}trades/`, `${base}draft/`] },
  { href: `${base}trades/`, label: 'Trades', icon: 'trades', group: 'team', desktop: false, parent: 'Front Office' },
  { href: `${base}draft/`, label: 'Draft', icon: 'draft', group: 'team', desktop: false, parent: 'Front Office' },
  { href: `${base}postseason/`, label: 'Postseason', icon: 'postseason', group: 'league' },
];
// 24x24 stroke icons (Tailgate's set, so the two sites match)
const NAV_ICONS: Record<string, string> = {
  home: '<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  dugout: '<path d="M4 5h13v14H5a1 1 0 0 1-1-1z"/><path d="M17 8h3v10a1 1 0 0 1-1 1h-2"/><path d="M7 9h7M7 13h7M7 17h4"/>',
  schedule: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  roster: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2.5h6V4"/><circle cx="9.5" cy="10.5" r="1.6"/><path d="m13 13 3 3m0-3-3 3"/>',
  postseason: '<path d="M3 4h5v6H3M3 14h5v6H3"/><path d="M8 7h4v10H8"/><path d="M12 12h4"/><path d="M16 9h5v6h-5z"/>',
  trades: '<path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/>',
  draft: '<path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/>',
  frontOffice: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  more: '<circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  refresh: '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
  settings: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
};
function isActiveLink(href: string) {
  return href === base ? pathname === base : pathname.startsWith(href);
}
// The desktop row marks Front Office while on Trades or Draft
function isActiveSection(link: { href: string; covers?: string[] }) {
  return isActiveLink(link.href) || (link.covers ?? []).some(isActiveLink);
}
const DESKTOP_LINKS = NAV_LINKS.filter(l => l.desktop !== false);
const TAB_LINKS = NAV_LINKS.filter(l => l.tab);
const MORE_LINKS = NAV_LINKS.filter(l => !l.tab);
const moreActive = MORE_LINKS.some(l => isActiveLink(l.href));
const stylePath = path.join(process.cwd(), 'public', 'style.css');
const styleVersion = Math.floor(statSync(stylePath).mtimeMs);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="description" content="Multi-team MLB news aggregator" />
    <title>{title}</title>
    <link rel="icon" type="image/jpeg" href={`${import.meta.env.BASE_URL}favicon.jpg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon.jpg`} />
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}style.css?v=${styleVersion}`} />
    <!--
      Theme and team accent, applied before first paint so the page never
      flashes the default. Mirrors theme.js (City Connect is Orioles-only and
      turns on automatically on Fridays). Brand colors are stored as-is in
      teamConfig.js; this lightens (dark theme) or darkens (light theme) each
      one until it has enough contrast: 3:1 for fills and borders, 4.5:1 for
      text. City Connect and Opacy keep the accent their CSS was designed with.
    -->
    <script is:inline define:vars={{ teamColors, legacyAbbr: LEGACY_ABBR }}>
      (function () {
        var root = document.documentElement;
        var ORIOLES = 110;
        var prefs = {};
        // Resolves the team the same way config.js does: ?team= (abbr or id)
        // saves a pick, ?view= shows another team without saving, else the
        // saved pick. No team yet: Orioles colors behind the picker.
        function find(q) {
          q = String(q || '').trim().toUpperCase();
          if (!q) return null;
          if (teamColors[q]) return Number(q);
          for (var k in teamColors) if (teamColors[k][2] === q) return Number(k);
          return legacyAbbr[q] || null;
        }
        var params = new URLSearchParams(location.search);
        var mine = null;
        try {
          // Older builds stored the team as fanbase_team and prefs as yr_prefs
          // (storage.js migrates the rest of the yr_* keys).
          var legacyTeam = localStorage.getItem('fanbase_team');
          if (legacyTeam !== null && localStorage.getItem('fb_team') === null) {
            localStorage.setItem('fb_team', legacyTeam);
          }
          var shared = find(params.get('team'));
          if (shared) {
            // A first team gets the welcome (onboarding.js, ONBOARD_PENDING_KEY)
            if (!find(localStorage.getItem('fb_team'))) localStorage.setItem('fb_onboard_pending', '1');
            localStorage.setItem('fb_team', String(shared));
            // Saved, so drop the param: a reload or bookmark is a plain link
            params.delete('team');
            var qs = params.toString();
            history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
          }
          mine = find(localStorage.getItem('fb_team'));
          prefs = JSON.parse(localStorage.getItem('fb_prefs') || localStorage.getItem('yr_prefs')) || {};
        } catch (e) {}
        var view = find(params.get('view'));
        var id = view || mine;
        if (view && view !== mine) root.setAttribute('data-viewing', '');
        var colorId = id || ORIOLES;

        var theme = prefs.theme || 'light';
        if (theme === 'system') theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        if (theme === 'city-connect' && id !== ORIOLES) theme = 'light';
        if (new Date().getDay() === 5 && id === ORIOLES) theme = 'city-connect';
        root.setAttribute('data-theme', theme);
        // Status bar follows the app's theme, not the system's
        var metas = document.querySelectorAll('meta[name="theme-color"]');
        for (var i = 0; i < metas.length; i++) {
          metas[i].removeAttribute('media');
          metas[i].setAttribute('content', theme === 'dark' ? '#111111' : '#ffffff');
        }

        function rgb(hex) {
          return [1, 3, 5].map(function (i) { return parseInt(hex.slice(i, i + 2), 16); });
        }
        function lum(c) {
          var v = c.map(function (x) { x /= 255; return x <= 0.03928 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4); });
          return 0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2];
        }
        function contrast(a, b) {
          var la = lum(a), lb = lum(b);
          return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);
        }
        // Blend c toward `toward` in 5% steps until it reaches `ratio` against bg
        function ensure(c, bg, ratio, toward) {
          for (var t = 0; t <= 1.0001; t += 0.05) {
            var m = c.map(function (x, i) { return Math.round(x + (toward[i] - x) * t); });
            if (contrast(m, bg) >= ratio) return m;
          }
          return toward;
        }
        function onColor(c) {
          return contrast(c, [255, 255, 255]) > contrast(c, [16, 24, 32]) ? '#ffffff' : '#101820';
        }
        function vars(hex, bg, toward) {
          var fill = ensure(rgb(hex), bg, 3, toward), text = ensure(rgb(hex), bg, 4.5, toward);
          return '{--accent:rgb(' + fill + ');--accent-text:rgb(' + text + ');--accent-rgb:' + fill +
            ';--accent-dim:rgba(' + fill + ',0.13);--on-accent:' + onColor(fill) + ';}';
        }
        // Backgrounds checked against: dark --surface, light --bg, and the
        // two Orioles easter-egg themes' --bg
        var WHITE = [255, 255, 255], BLACK = [0, 0, 0];
        var css = ':root' + vars(teamColors[colorId][1], [23, 23, 23], WHITE) +
          '[data-theme="light"]' + vars(teamColors[colorId][0], [245, 245, 245], BLACK) +
          '[data-theme="city-connect"]' + vars('#c84b11', [255, 255, 255], BLACK) +
          '[data-theme="opacy"]' + vars('#ff6b1a', [26, 10, 0], WHITE);
        var style = document.createElement('style');
        style.id = 'teamAccent';
        style.textContent = css;
        document.head.appendChild(style);
      })();
    </script>
  </head>
  <body>
    <!-- Desktop: icon + label row (moved below the header after <slot />) -->
    <nav class="site-nav" aria-label="Site navigation">
      {DESKTOP_LINKS.map((link, i) => (
        <Fragment>
          {i > 0 && DESKTOP_LINKS[i - 1].group !== link.group && <span class="site-nav-sep" aria-hidden="true"></span>}
          <a
            href={link.href}
            class={`site-nav-link${isActiveSection(link) ? ' site-nav-link--active' : ''}`}
            aria-current={isActiveLink(link.href) ? 'page' : isActiveSection(link) ? 'true' : undefined}
          >
            <svg class="site-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={NAV_ICONS[link.icon]} />
            {link.label}
          </a>
        </Fragment>
      ))}
    </nav>
    <!-- Phones and tablets: bottom tab bar; More opens a sheet with the rest -->
    <nav class="tab-bar" aria-label="Site navigation">
      {TAB_LINKS.map(link => (
        <a href={link.href} class={`tab-bar-link${isActiveLink(link.href) ? ' tab-bar-link--active' : ''}`} aria-current={isActiveLink(link.href) ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={NAV_ICONS[link.icon]} />
          <span>{link.label}</span>
        </a>
      ))}
      <button type="button" class={`tab-bar-link${moreActive ? ' tab-bar-link--active' : ''}`} id="tabMoreBtn" aria-expanded="false" aria-controls="moreSheet">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={NAV_ICONS.more} />
        <span>More</span>
      </button>
    </nav>
    <div class="more-sheet" id="moreSheet" hidden>
      <div class="more-sheet-scrim" data-more-close></div>
      <div class="more-sheet-panel" role="dialog" aria-modal="true" aria-label="More">
        <span class="more-sheet-grip" aria-hidden="true"></span>
        {MORE_LINKS.map(link => (
          <a href={link.href} class={`more-sheet-link${link.parent ? ' more-sheet-link--sub' : ''}${isActiveLink(link.href) ? ' more-sheet-link--active' : ''}`} aria-current={isActiveLink(link.href) ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={NAV_ICONS[link.icon]} />
            {link.label}
          </a>
        ))}
        <span class="more-sheet-sep" aria-hidden="true"></span>
        <button type="button" class="more-sheet-link" data-open-search>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={NAV_ICONS.search} />
          Search
        </button>
        <!-- Pages with a refresh (Home, Dugout) unhide this and handle it -->
        <button type="button" class="more-sheet-link" data-refresh hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={NAV_ICONS.refresh} />
          Refresh
        </button>
        <button type="button" class="more-sheet-link" data-open-settings>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={NAV_ICONS.settings} />
          Settings
        </button>
      </div>
    </div>
    <script is:inline>
      // More sheet: opens from the tab bar, closes on the scrim, Escape, or
      // any action in it (pages navigate away on their own)
      (function () {
        var btn = document.getElementById('tabMoreBtn');
        var sheet = document.getElementById('moreSheet');
        if (!btn || !sheet) return;
        function setOpen(open) {
          sheet.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
          if (open) { var first = sheet.querySelector('.more-sheet-link'); if (first) first.focus(); }
        }
        btn.addEventListener('click', function () { setOpen(sheet.hidden); });
        sheet.addEventListener('click', function (e) {
          if (e.target.closest('[data-more-close], [data-open-search], [data-refresh], [data-open-settings]')) setOpen(false);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !sheet.hidden) { setOpen(false); btn.focus(); }
        });
      })();
    </script>
    <slot />
    <script is:inline>
      // Desktop menu sits below the banner: on Home under the scores bar,
      // elsewhere under the header. Moved before first paint so nothing
      // jumps. Phones and tablets hide it (they have the tab bar).
      (function () {
        var nav = document.querySelector('.site-nav');
        var after = document.querySelector('.scores-bar') || document.querySelector('.site-header');
        if (nav && after) after.after(nav);
      })();
    </script>
    <SettingsPanel />
    <footer class="site-footer">
      <button class="feedback-link" type="button" data-feedback>Send feedback</button>
    </footer>
    <script>
      import '../scripts/search.js';
      import '../scripts/onboarding.js';
      import '../scripts/feedback.js';
      import '../scripts/settings.js';
    </script>
    <script is:inline define:vars={{ base }}>
      // While viewing another team (?view=), keep it on every link within the
      // site, including links pages add later, until "Back to …" drops it
      (function () {
        var view = new URLSearchParams(location.search).get('view');
        if (!view || !document.documentElement.hasAttribute('data-viewing')) return;
        function carry(a) {
          if (!a || !a.href || a.hasAttribute('data-no-view')) return;
          var u = new URL(a.href, location.href);
          if (u.origin !== location.origin || u.pathname.indexOf(base) !== 0) return;
          if (u.searchParams.has('view') || u.searchParams.has('team') || /\.[a-z0-9]+$/i.test(u.pathname)) return;
          u.searchParams.set('view', view);
          a.href = u.href;
        }
        document.querySelectorAll('a[href]').forEach(carry);
        ['click', 'auxclick', 'contextmenu', 'focusin'].forEach(function (t) {
          document.addEventListener(t, function (e) { carry(e.target.closest && e.target.closest('a[href]')); }, true);
        });
      })();
    </script>
  </body>
</html>
