---
import { statSync } from 'node:fs';
import path from 'node:path';
import { TEAM_CONFIG } from '../scripts/teamConfig.js';

interface Props {
  title?: string;
}
const { title = 'Fanbase' } = Astro.props;
// id → [light-theme color, dark-theme color, abbr] for the head script below
const teamColors = Object.fromEntries(
  Object.values(TEAM_CONFIG).map(t => [t.id, [t.color, t.colorDark ?? t.color, t.abbr]])
);
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
// Grouped by how often each page is used: today, your team's season, then
// league-wide events. A divider separates the groups.
const NAV_LINKS = [
  { href: base, label: 'Home', group: 'today' },
  { href: `${base}schedule/`, label: 'Schedule', group: 'team' },
  { href: `${base}depth-chart/`, label: 'Depth Chart', group: 'team' },
  { href: `${base}trades/`, label: 'Trades', group: 'league' },
  { href: `${base}draft/`, label: 'Draft', group: 'league' },
  { href: `${base}postseason/`, label: 'Postseason', group: 'league' },
];
function isActiveLink(href: string) {
  return href === base ? pathname === base : pathname.startsWith(href);
}
const stylePath = path.join(process.cwd(), 'public', 'style.css');
const styleVersion = Math.floor(statSync(stylePath).mtimeMs);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="description" content="Multi-team MLB news aggregator" />
    <title>{title}</title>
    <link rel="icon" type="image/jpeg" href={`${import.meta.env.BASE_URL}favicon.jpg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon.jpg`} />
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}style.css?v=${styleVersion}`} />
    <!--
      Theme and team accent, applied before first paint so the page never
      flashes the default. Mirrors theme.js (City Connect is Orioles-only and
      turns on automatically on Fridays). Brand colors are stored as-is in
      teamConfig.js; this lightens (dark theme) or darkens (light theme) each
      one until it has enough contrast: 3:1 for fills and borders, 4.5:1 for
      text. City Connect and Opacy keep the accent their CSS was designed with.
    -->
    <script is:inline define:vars={{ teamColors }}>
      (function () {
        var root = document.documentElement;
        var ORIOLES = 110;
        var prefs = {};
        // Resolves the team the same way config.js does: ?team= (abbr or id)
        // saves a pick, ?view= shows another team without saving, else the
        // saved pick. No team yet: Orioles colors behind the picker.
        function find(q) {
          q = String(q || '').trim().toUpperCase();
          if (!q) return null;
          if (teamColors[q]) return Number(q);
          for (var k in teamColors) if (teamColors[k][2] === q) return Number(k);
          return null;
        }
        var params = new URLSearchParams(location.search);
        var mine = null;
        try {
          // Older builds stored the team as fanbase_team and prefs as yr_prefs
          // (storage.js migrates the rest of the yr_* keys).
          var legacyTeam = localStorage.getItem('fanbase_team');
          if (legacyTeam !== null && localStorage.getItem('fb_team') === null) {
            localStorage.setItem('fb_team', legacyTeam);
          }
          var shared = find(params.get('team'));
          if (shared) {
            localStorage.setItem('fb_team', String(shared));
            // Saved, so drop the param: a reload or bookmark is a plain link
            params.delete('team');
            var qs = params.toString();
            history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
          }
          mine = find(localStorage.getItem('fb_team'));
          prefs = JSON.parse(localStorage.getItem('fb_prefs') || localStorage.getItem('yr_prefs')) || {};
        } catch (e) {}
        var view = find(params.get('view'));
        var id = view || mine;
        if (view && view !== mine) root.setAttribute('data-viewing', '');
        var colorId = id || ORIOLES;

        var theme = prefs.theme || 'light';
        if (theme === 'system') theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        if (theme === 'city-connect' && id !== ORIOLES) theme = 'light';
        if (new Date().getDay() === 5 && id === ORIOLES) theme = 'city-connect';
        root.setAttribute('data-theme', theme);
        // Status bar follows the app's theme, not the system's
        var metas = document.querySelectorAll('meta[name="theme-color"]');
        for (var i = 0; i < metas.length; i++) {
          metas[i].removeAttribute('media');
          metas[i].setAttribute('content', theme === 'dark' ? '#111111' : '#ffffff');
        }

        function rgb(hex) {
          return [1, 3, 5].map(function (i) { return parseInt(hex.slice(i, i + 2), 16); });
        }
        function lum(c) {
          var v = c.map(function (x) { x /= 255; return x <= 0.03928 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4); });
          return 0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2];
        }
        function contrast(a, b) {
          var la = lum(a), lb = lum(b);
          return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);
        }
        // Blend c toward `toward` in 5% steps until it reaches `ratio` against bg
        function ensure(c, bg, ratio, toward) {
          for (var t = 0; t <= 1.0001; t += 0.05) {
            var m = c.map(function (x, i) { return Math.round(x + (toward[i] - x) * t); });
            if (contrast(m, bg) >= ratio) return m;
          }
          return toward;
        }
        function onColor(c) {
          return contrast(c, [255, 255, 255]) > contrast(c, [16, 24, 32]) ? '#ffffff' : '#101820';
        }
        function vars(hex, bg, toward) {
          var fill = ensure(rgb(hex), bg, 3, toward), text = ensure(rgb(hex), bg, 4.5, toward);
          return '{--accent:rgb(' + fill + ');--accent-text:rgb(' + text + ');--accent-rgb:' + fill +
            ';--accent-dim:rgba(' + fill + ',0.13);--on-accent:' + onColor(fill) + ';}';
        }
        // Backgrounds checked against: dark --surface, light --bg, and the
        // two Orioles easter-egg themes' --bg
        var WHITE = [255, 255, 255], BLACK = [0, 0, 0];
        var css = ':root' + vars(teamColors[colorId][1], [23, 23, 23], WHITE) +
          '[data-theme="light"]' + vars(teamColors[colorId][0], [245, 245, 245], BLACK) +
          '[data-theme="city-connect"]' + vars('#c84b11', [255, 255, 255], BLACK) +
          '[data-theme="opacy"]' + vars('#ff6b1a', [26, 10, 0], WHITE);
        var style = document.createElement('style');
        style.id = 'teamAccent';
        style.textContent = css;
        document.head.appendChild(style);
      })();
    </script>
  </head>
  <body>
    <nav class="site-nav" aria-label="Site navigation">
      {NAV_LINKS.map((link, i) => (
        <Fragment>
          {i > 0 && NAV_LINKS[i - 1].group !== link.group && <span class="site-nav-sep" aria-hidden="true"></span>}
          <a
            href={link.href}
            class={`site-nav-link${isActiveLink(link.href) ? ' site-nav-link--active' : ''}`}
            aria-current={isActiveLink(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </Fragment>
      ))}
    </nav>
    <slot />
    <script is:inline define:vars={{ base }}>
      // While viewing another team (?view=), keep it on every link within the
      // site, including links pages add later, until "Back to …" drops it
      (function () {
        var view = new URLSearchParams(location.search).get('view');
        if (!view || !document.documentElement.hasAttribute('data-viewing')) return;
        function carry(a) {
          if (!a || !a.href || a.hasAttribute('data-no-view')) return;
          var u = new URL(a.href, location.href);
          if (u.origin !== location.origin || u.pathname.indexOf(base) !== 0) return;
          if (u.searchParams.has('view') || u.searchParams.has('team') || /\.[a-z0-9]+$/i.test(u.pathname)) return;
          u.searchParams.set('view', view);
          a.href = u.href;
        }
        document.querySelectorAll('a[href]').forEach(carry);
        ['click', 'auxclick', 'contextmenu', 'focusin'].forEach(function (t) {
          document.addEventListener(t, function (e) { carry(e.target.closest && e.target.closest('a[href]')); }, true);
        });
      })();
    </script>
  </body>
</html>
