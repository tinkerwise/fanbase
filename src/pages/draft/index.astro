---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Draft | Fanbase">
  <PageHeader current="Draft" />

  <div class="draft-ticker-wrap" aria-label="Your team's draft picks">
    <span class="draft-ticker-label" id="draftTickerLabel">Picks</span>
    <div class="draft-ticker-viewport">
      <div class="draft-ticker-track" id="draftTickerTrack"><span class="draft-ticker-item">Loading…</span></div>
    </div>
  </div>

  <main class="event-page">
    <div class="event-container">

      <div class="event-main">
        <div class="event-main-head">
          <h1 class="event-title">2026 MLB Draft News</h1>
          <span class="event-updated" id="draftUpdated"></span>
        </div>

        <section class="draft-hero" id="draftHero">
          <div class="draft-hero-diamond" aria-hidden="true">
            <svg viewBox="0 0 200 200" fill="none">
              <path d="M100 20 L180 100 L100 180 L20 100 Z" stroke="currentColor" stroke-width="2"/>
              <circle cx="100" cy="100" r="8" fill="currentColor"/>
            </svg>
          </div>
          <img class="draft-hero-logo" id="draftHeroLogo" src={`${base}logo.png`} alt="" width="56" height="56" loading="eager">
          <div class="draft-hero-body">
            <span class="draft-hero-badge" id="draftHeroBadge">Loading…</span>
            <div class="draft-hero-facts" id="draftHeroFacts"></div>
          </div>
        </section>

        <section class="prospect-board" id="prospectBoardSection">
          <div class="prospect-board-title-row">
            <h2 class="prospect-board-title">Top Prospects Remaining</h2>
            <span class="prospect-board-subtitle">Our big board, minus whoever's already off it</span>
          </div>
          <div id="draftProspectBoard">
            <span class="sidebar-msg">Loading…</span>
          </div>
        </section>

        <div class="draft-highlights-grid" id="draftHighlights"></div>

        <div class="draft-broadcast" id="draftBroadcast"></div>

        <div class="event-team-col">
          <div class="event-team-head">Draft News</div>
          <div id="draftNews"><span class="sidebar-msg">Loading…</span></div>
        </div>
      </div>

      <aside class="sidebar event-sidebar">
        <div class="sidebar-section" data-section="draft-info">
          <h3 class="section-label">Draft Info</h3>
          <div class="section-body" id="draftInfo">
            <span class="sidebar-msg">Loading…</span>
          </div>
        </div>

        <div class="sidebar-section" data-section="draft-order">
          <h3 class="section-label">Round Order</h3>
          <div class="section-body">
            <div class="pill-group" id="draftRoundTabs"></div>
            <div id="draftOrder" class="draft-order-list"><span class="sidebar-msg">Loading…</span></div>
          </div>
        </div>

        <div class="sidebar-section collapsible collapsed" data-section="draft-history">
          <h3 class="section-label section-toggle" data-target="draft-history">
            <span><span data-team-text="nick">Team</span> Draft History</span>
            <svg class="section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </h3>
          <div class="section-body" id="draftHistory">
            <span class="sidebar-msg">Loading…</span>
          </div>
        </div>

        <div class="sidebar-section collapsible collapsed" data-section="draft-sources">
          <h3 class="section-label section-toggle" data-target="draft-sources">
            Sources &amp; Live Coverage
            <svg class="section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </h3>
          <div class="section-body">
            <div class="draft-links-label">Live Coverage</div>
            <div id="draftLiveCoverage"><span class="sidebar-msg">Loading…</span></div>
            <div class="draft-links-label">Sources</div>
            <div id="draftSources"><span class="sidebar-msg">Loading…</span></div>
          </div>
        </div>
      </aside>

    </div>
  </main>
</Layout>

<script>
  import '../../scripts/draft.js';
</script>
