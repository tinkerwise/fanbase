---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Trades | Fanbase">
  <PageHeader current="Trades" />

  <main class="event-page">
    <div class="event-container">

      <div class="event-main">
        <div class="event-main-head">
          <h1 class="event-title">
            2026 Trade Deadline
            <span class="info-trigger" tabindex="0">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              <span class="info-popover">
                <p>Every team has until <strong>August 3 at 6:00 PM ET</strong> to make a trade before rosters lock in for the stretch run. Contenders look to add; rebuilding teams look to sell rentals and pending free agents for prospects. Nothing here is confirmed until a team announces it — rumors and reporting are labeled as such, not completed trades.</p>
                <p>Speculation is part of the deadline — it always is — but this page only pulls from outlets with named-reporter bylines and a track record of accurate sourcing. The "Reporters to Watch" list links straight to the insiders who break most of the real news, since the fastest-moving rumors often land on social media before any outlet publishes.</p>
              </span>
            </span>
          </h1>
          <span class="event-updated" id="tdUpdated"></span>
        </div>

        <div class="event-team-col">
          <div class="event-team-head"><span data-team-text="nick">Team</span> Moves</div>
          <div id="tdMoves"><span class="sidebar-msg">Loading…</span></div>
        </div>

        <div class="event-team-col">
          <div class="event-team-head">On the Block</div>
          <p class="trades-onblock-note">Names pulled directly from trade rumor headlines below that mention your team — a mention isn't a confirmation of anything, just a signal of who reporters are talking about. Hover a name for a quick profile.</p>
          <div id="tdOnBlock"><span class="sidebar-msg">Loading…</span></div>
        </div>

        <div class="event-team-col draft-order-col">
          <div class="event-team-head event-team-head-row">
            <span>Organization Watch</span>
            <span class="event-updated" id="tdOrgCount"></span>
          </div>
          <p class="trades-onblock-note">The full 40-man roster plus every full-season minor-league affiliate, cross-checked against the same trade rumor text — anyone showing up gets flagged right where they sit in the system.</p>
          <div id="tdOrgRoster" class="draft-order-list trades-org-list"><span class="sidebar-msg">Loading…</span></div>
        </div>
      </div>

      <aside class="sidebar event-sidebar">
        <div class="sidebar-section" data-section="trades-info">
          <h3 class="section-label">Deadline Info</h3>
          <div class="section-body" id="tdInfo">
            <span class="sidebar-msg">Loading…</span>
          </div>
        </div>

        <div class="sidebar-section collapsible" data-section="trades-news">
          <h3 class="section-label section-toggle" data-target="trades-news">
            Trade Rumors
            <svg class="section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </h3>
          <div class="section-body" id="tdNews">
            <span class="sidebar-msg">Loading…</span>
          </div>
        </div>

        <div class="sidebar-section collapsible" data-section="trades-longshots">
          <h3 class="section-label section-toggle" data-target="trades-longshots">
            Long Shots &amp; Wild Cards
            <svg class="section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </h3>
          <div class="section-body" id="tdLongShots">
            <span class="sidebar-msg">Loading…</span>
          </div>
        </div>

        <div class="sidebar-section collapsible" data-section="trades-reporters">
          <h3 class="section-label section-toggle" data-target="trades-reporters">
            Reporters to Watch
            <svg class="section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </h3>
          <div class="section-body" id="tdReporters">
            <span class="sidebar-msg">Loading…</span>
          </div>
        </div>
      </aside>

    </div>
  </main>
</Layout>

<script>
  import '../../scripts/trades.js';
</script>
