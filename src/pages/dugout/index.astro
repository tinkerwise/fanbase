---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import NewsFeed from '../../components/NewsFeed.astro';
import ReaderOverlay from '../../components/ReaderOverlay.astro';
---

<Layout title="Dugout | Fanbase">
  <PageHeader current="Dugout" />

  <main class="dugout-page">
    <div class="dugout-page-head">
      <div>
        <h1 class="dugout-page-title">Dugout</h1>
        <p class="dugout-page-sub">Every <span data-team-text="nick">team</span> story from all your news sources</p>
      </div>
      <div class="search-wrap dugout-page-search">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input class="search-input" id="searchInput" type="search" placeholder="Search all articles…" autocomplete="off" />
      </div>
    </div>
    <div class="feed-area dugout-page-feed">
      <NewsFeed />
    </div>
  </main>

  <ReaderOverlay />
</Layout>

<script>
  import '../../scripts/dugout.js';
</script>
