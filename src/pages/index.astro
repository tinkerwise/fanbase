---
import Layout from '../layouts/Layout.astro';
import NewsFeed from '../components/NewsFeed.astro';
import ReaderOverlay from '../components/ReaderOverlay.astro';
import FrontOfficeWidgets from '../components/FrontOfficeWidgets.astro';
import FrontOfficeLinks from '../components/FrontOfficeLinks.astro';
---

<Layout title="Fanbase">
  <!-- Header -->
  <header class="site-header">
    <div class="header-inner">
      <a class="logo" href="https://www.briancsmith.org/fanbase">
        <img class="logo-img" src={`${import.meta.env.BASE_URL}logo.png`} alt="Fanbase logo" width="88" height="62" />
        <span class="logo-wordmark" aria-label="Fanbase">
          <span class="logo-word">Fan</span>
          <strong class="logo-word logo-word-accent">base</strong>
        </span>
      </a>
      <div class="header-right">
        <span class="cache-label" id="cacheLabel"></span>
        <button class="btn-search" type="button" aria-label="Search" title="Search (/ or ⌘K)" data-open-search><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
        <button class="btn-refresh" id="refreshBtn" aria-label="Refresh news">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
            <path d="M21 3v5h-5"/>
            <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
            <path d="M8 16H3v5"/>
          </svg>
          <span>Refresh</span>
        </button>
        <button class="btn-settings" id="settingsBtn" type="button" aria-label="Settings" data-open-settings>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Scores Bar -->
  <div class="scores-bar">
    <div class="scores-track" id="scoresTrack">
      <span class="scores-msg">Loading scores…</span>
    </div>
  </div>

  <!-- Hardball (#20): shown in the offseason or a lockout (season.js) -->
  <a class="hardball-banner" href={`${import.meta.env.BASE_URL}hardball/`} data-offseason-only>
    <span class="hardball-banner-kicker">Hardball</span>
    <span class="hardball-banner-text" id="hardballBannerText">MLB labor talks: the CBA expires December 1</span>
    <span class="hardball-banner-count" id="hardballBannerCount"></span>
    <svg class="hardball-banner-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
  </a>

  <!-- Page Layout -->
  <div class="page-layout">

    <!-- Left Sidebar -->
    <aside class="sidebar sidebar-left">
      <!-- Search -->
      <div class="search-wrap">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input class="search-input" id="searchInput" type="search" placeholder="Search all articles…" autocomplete="off" />
      </div>

      <!-- On Deck + Schedule -->
      <div class="sidebar-section collapsible" data-section="ondeck">
        <h3 class="section-label section-toggle" data-target="ondeck">
          <svg class="section-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          On Deck
          <svg class="section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </h3>
        <div class="section-body" id="onDeckWrap">
          <span class="sidebar-msg">Loading…</span>
        </div>
      </div>

      <!-- Full schedule link -->
      <a class="section-schedule-link" href={`${import.meta.env.BASE_URL}schedule/`}>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        Full Schedule
      </a>

      <!-- Podcast -->
      <div class="sidebar-section collapsible" data-section="podcast">
        <h3 class="section-label section-toggle" data-target="podcast">
          <svg class="section-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 18a4 4 0 0 0 4-4V8a4 4 0 1 0-8 0v6a4 4 0 0 0 4 4Z"/><path d="M19 10v4a7 7 0 0 1-14 0v-4"/><path d="M12 21v-3"/></svg>
          Podcast
          <svg class="section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </h3>
        <div class="section-body" id="podcastWrap">
          <span class="sidebar-msg">Loading…</span>
        </div>
      </div>

      <!-- Video -->
      <div class="sidebar-section collapsible" data-section="video">
        <h3 class="section-label section-toggle" data-target="video">
          <svg class="section-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
          Video
          <svg class="section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </h3>
        <div class="section-body" id="videoWrap">
          <span class="sidebar-msg">Loading…</span>
        </div>
      </div>
    </aside>

    <!-- Feed -->
    <main class="feed-area">
      <NewsFeed />
    </main>

    <!-- Right Sidebar -->
    <aside class="sidebar sidebar-right">
      <!-- Standings -->
      <div class="sidebar-section collapsible" data-section="standings">
        <h3 class="section-label section-toggle" data-target="standings">
          <svg class="section-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 21h8m-4-4v4M3 11h18M5 11V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6"/><path d="m12 11-1.5 4h3L12 11z"/></svg>
          Standings
          <svg class="section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </h3>
        <div class="section-body">
          <div class="div-tabs" id="divTabs"></div>
          <div id="standingsWrap">
            <span class="sidebar-msg">Loading…</span>
          </div>
        </div>
      </div>

      <!-- Yard Leaders -->
      <div class="sidebar-section collapsible collapsed" data-section="leaders">
        <h3 class="section-label section-toggle" data-target="leaders">
          <svg class="section-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          Yard Leaders
          <svg class="section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </h3>
        <div class="section-body" id="leadersWrap">
          <span class="sidebar-msg">Loading…</span>
        </div>
      </div>

      <!-- Front Office: team widgets, then the Roster, Trades and Draft pages
           (Tailgate #22). On phones the label toggles the group, which starts
           collapsed (Tailgate #37, app.js). The heading links to the full
           Front Office page. -->
      <div class="sidebar-group sidebar-group--fo">
        <div class="sidebar-group-label" id="frontOfficeToggle" aria-controls="frontOfficeBody">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          <a class="sidebar-group-title" href={`${import.meta.env.BASE_URL}front-office/`}>Front Office</a>
          <span class="sidebar-group-hint">Injuries, payroll, roster, trades &amp; draft</span>
          <svg class="sidebar-group-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </div>
        <div class="sidebar-group-body" id="frontOfficeBody">
          <FrontOfficeWidgets collapsible />
          <FrontOfficeLinks />
        </div>
      </div>

    </aside>

  </div>

  <ReaderOverlay />
</Layout>

<script>
  import '../scripts/app.js';
</script>
