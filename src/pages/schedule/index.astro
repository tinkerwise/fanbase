---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<Layout title="Schedule | Fanbase">
  <PageHeader current="Schedule" />

  <main class="schedule-page">
    <div class="schedule-container">

      <!-- Toolbar -->
      <div class="schedule-toolbar">
        <div class="schedule-nav-group">
          <button class="sch-nav-btn" id="prevBtn" aria-label="Previous">‹</button>
          <h2 class="sch-title" id="schTitle">Loading…</h2>
          <button class="sch-nav-btn" id="nextBtn" aria-label="Next">›</button>
          <button class="sch-today-btn" id="todayBtn">Today</button>
        </div>
        <div class="sch-view-group" role="group" aria-label="Calendar view">
          <button class="sch-view-btn active" data-view="month">Month</button>
          <button class="sch-view-btn" data-view="week">Week</button>
        </div>
      </div>

      <!-- Legend -->
      <div class="sch-legend">
        <span class="sch-legend-item legend--home">🏟 Home</span>
        <span class="sch-legend-item legend--away">✈ Away</span>
        <span class="sch-legend-item legend--live">● Live</span>
        <span class="sch-legend-item legend--preview">W 5–3 · L 2–4</span>
        <span class="sch-legend-item legend--spring">ST Spring training</span>
        <span class="sch-legend-item legend--off">Postponed · Cancelled</span>
        <span class="sch-legend-item legend--key">★ Key date</span>
        <span class="sch-updated" id="schUpdated" aria-live="polite"></span>
      </div>

      <!-- Games that moved since the last visit (#42) -->
      <p class="sch-changes" id="schChanges" hidden></p>

      <!-- Calendar -->
      <div id="scheduleGrid">
        <div class="sch-loading">Loading schedule…</div>
      </div>
      <p class="sch-empty-note" id="schEmpty" hidden></p>

    </div>
  </main>
</Layout>


<script type="module">
  import '../../scripts/theme.js';
  import { MLB, TEAM_ID, SEASON, TEAM_ABBREV } from '../../scripts/config.js';
  import { requireTeam } from '../../scripts/teamPicker.js';
  import { esc } from '../../scripts/utils.js';
  import { fetchWeatherForGames, getGameWeather } from '../../scripts/weather.js';
  import { flattenSchedule, gameStatus, isPlayedEntry, shortDay, changedSinceLastVisit } from '../../scripts/scheduleGames.js';
  import { keyDatesFor, keyDateNote, isOff } from '../../scripts/keyDates.js';

  // ── Constants ─────────────────────────────────────────────────
  const MONTHS = [
    'January','February','March','April','May','June',
    'July','August','September','October','November','December',
  ];
  const DAYS_SHORT = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  const NATIONAL_TV = ['ESPN','ESPN2','FOX','FS1','FS2','TBS','Apple TV+','Peacock','MLBN','MLB Network'];
  // The schedule loads when the page opens and again once a day while it
  // stays open, so reschedules show up without a reload (#42)
  const DAY_MS = 24 * 60 * 60 * 1000;

  // ── State ─────────────────────────────────────────────────────
  let allGames = [];   // every listing, each with _day (scheduleGames.js)
  let seriesMap = new Map(); // `${gamePk}|${_day}` → { gameNum, total, isFirst, isLast }
  let changed = new Set();   // gamePks that moved since the last visit
  let viewMode = 'month';
  let viewDate = new Date();
  let lastFetch = 0;
  let keysByDay = {};  // YYYY-MM-DD → key dates starting that day (key-dates.json)

  // ── Date helpers ──────────────────────────────────────────────
  function dateStr(d) {
    return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  }
  function todayStr() { return dateStr(new Date()); }
  const entryKey = g => `${g.gamePk}|${g._day}`;

  // ── Key dates (#42) ───────────────────────────────────────────
  // Baseball's calendar alongside the games: Rule 5 Draft, international
  // signing day, Opening Day… (key-dates.json, tag schedule). A stretch
  // like the Winter Meetings is marked on its first day.
  function indexKeyDates(entries) {
    keysByDay = {};
    for (const e of entries) {
      if (!e.date) continue;
      (keysByDay[e.date] ??= []).push(e);
    }
  }

  function keyMarkers(key, full = false) {
    return (keysByDay[key] ?? []).map(e => {
      const note = keyDateNote(e);
      const range = e.dateEnd ? `through ${shortDay(e.dateEnd, false)}` : '';
      const tip = [e.title, range && `(${range})`, note && `· ${note}`, e.detail && `— ${e.detail}`].filter(Boolean).join(' ');
      const extra = [range, note].filter(Boolean).join(' · ');
      return `<span class="cal-key${isOff(e) ? ' cal-key--off' : ''}${full ? ' cal-key--full' : ''}" title="${esc(tip)}">
        <span class="cal-key-star" aria-hidden="true">★</span><span class="cal-key-title">${esc(e.title)}</span>${extra && (full || note) ? `<span class="cal-key-extra">${esc(full ? extra : note)}</span>` : ''}
      </span>`;
    }).join('');
  }

  // ── Game helpers ──────────────────────────────────────────────
  function oriIsHome(g)  { return g.teams.home.team.id === TEAM_ID; }
  function oriSide(g)    { return oriIsHome(g) ? g.teams.home : g.teams.away; }
  function oppSide(g)    { return oriIsHome(g) ? g.teams.away : g.teams.home; }
  function getOpponent(g) { return oppSide(g).team; }
  function oppAbbr(g) {
    const opp = getOpponent(g);
    return TEAM_ABBREV[opp.id] ?? opp.abbreviation ?? opp.name.slice(0, 3).toUpperCase();
  }

  // A result only for a final with a score: a postponed or cancelled game is
  // "Final" too, with no score, and used to show as "L 0–0"
  function getResult(g, st) {
    if (st.state !== 'final') return null;
    const ori = oriSide(g);
    const opp = oppSide(g);
    return {
      result: g.isTie || ori.score === opp.score ? 'T' : (ori.isWinner ? 'W' : 'L'),
      oriScore: ori.score,
      oppScore: opp.score,
    };
  }

  function oriProbable(g) {
    const p = oriSide(g).probablePitcher;
    if (!p?.fullName) return null;
    return p.fullName.trim().split(/\s+/).at(-1);
  }

  function getBroadcast(g) {
    const tv = (g.broadcasts ?? []).filter(b => b.type === 'TV' && b.language !== 'es');
    const national = tv.find(b => NATIONAL_TV.some(n => b.name?.includes(n)));
    if (national) return national.name;
    const local = tv.find(b => b.name?.includes('MASN'));
    return local?.name ?? null;
  }

  // ── Series detection ──────────────────────────────────────────
  // Regular season and postseason games actually played, one entry per game
  // (not the postponed/suspended listings), in order
  function buildSeries(games) {
    const sorted = games
      .filter(g => g.gameType !== 'S' && isPlayedEntry(g))
      .sort((a, b) => new Date(a.gameDate) - new Date(b.gameDate));
    seriesMap = new Map();
    let group = [];
    let lastOppId = null;

    const finalize = grp => grp.forEach((g, i) => {
      seriesMap.set(entryKey(g), {
        gameNum: i + 1,
        total: grp.length,
        isFirst: i === 0,
        isLast: i === grp.length - 1,
      });
    });

    for (const g of sorted) {
      const oppId = getOpponent(g).id;
      if (group.length > 0) {
        const lastDay = new Date(group.at(-1)._day);
        const thisDay = new Date(g._day);
        const diff = (thisDay - lastDay) / DAY_MS;
        if (oppId === lastOppId && diff <= 2) {
          group.push(g);
          continue;
        }
        finalize(group);
      }
      group = [g];
      lastOppId = oppId;
    }
    if (group.length > 0) finalize(group);
  }

  // ── Chip status ───────────────────────────────────────────────
  // { html, note, title, cls }: the status line, an extra line for moved
  // games, a plain-text description for the tooltip and screen readers, and
  // any extra chip class
  function chipStatus(g, st, compact) {
    const result = getResult(g, st);
    const why = st.reason ? ` (${st.reason})` : '';
    const parts = { html: '', note: '', title: '', cls: '' };

    switch (st.state) {
      case 'postponed':
        parts.cls = ' chip--off';
        parts.html = `<span class="chip-off">${compact ? 'PPD' : 'Postponed'}</span>`;
        parts.note = st.makeupOn
          ? `${compact ? '→' : 'Moved to'} ${shortDay(st.makeupOn, !compact)}`
          : (compact ? 'Makeup TBD' : 'Makeup date to be announced');
        parts.title = `Postponed${why}. ${st.makeupOn ? `Moved to ${shortDay(st.makeupOn)}.` : 'Makeup date to be announced.'}`;
        return parts;
      case 'cancelled':
        parts.cls = ' chip--off';
        parts.html = `<span class="chip-off">${compact ? 'Canc.' : 'Cancelled'}</span>`;
        parts.title = `Cancelled${why}.`;
        return parts;
      case 'suspended':
        parts.cls = ' chip--off';
        parts.html = `<span class="chip-off">${compact ? 'Susp.' : 'Suspended'}</span>`;
        parts.note = st.resumesOn
          ? `${compact ? 'Resumes' : 'Finishes'} ${shortDay(st.resumesOn, !compact)}`
          : (compact ? 'Resume TBD' : 'Resume date to be announced');
        parts.title = `Suspended${why}. ${st.resumesOn ? `Finishes ${shortDay(st.resumesOn)}.` : 'Resume date to be announced.'}`;
        return parts;
    }

    if (result) {
      parts.html = `<span class="chip-result">${result.result} ${result.oriScore}–${result.oppScore}</span>`;
      parts.title = `${result.result === 'W' ? 'Won' : result.result === 'L' ? 'Lost' : 'Tied'} ${result.oriScore}–${result.oppScore}.`;
    } else if (st.state === 'live') {
      parts.cls = ' chip--live';
      const half = g.linescore?.inningHalf === 'Top' ? '▲' : '▼';
      const inn  = g.linescore?.currentInning ?? '';
      parts.html = `<span class="chip-live">${half}${inn}</span>`;
      parts.title = 'In progress.';
    } else {
      let t;
      if (st.afterGame1) t = compact ? 'After G1' : 'After game 1';
      else if (st.timeTBD) t = compact ? 'TBD' : 'Time TBD';
      else t = new Date(g.gameDate).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
      parts.html = `<span class="chip-time">${esc(t)}</span>`;
      parts.title = st.afterGame1 ? 'Starts after game 1.' : st.timeTBD ? 'Start time to be announced.' : `${t}.`;
    }

    if (st.movedFrom) {
      parts.note = `${compact ? 'From' : 'Moved from'} ${shortDay(st.movedFrom, !compact)}`;
      parts.title += ` Makeup of the game postponed on ${shortDay(st.movedFrom)}.`;
    } else if (st.resumedFrom) {
      parts.note = `${compact ? 'Resumed' : 'Resumed from'} ${shortDay(st.resumedFrom, !compact)}`;
      parts.title += ` Finish of the game suspended on ${shortDay(st.resumedFrom)}.`;
    }
    return parts;
  }

  // ── Chip rendering ────────────────────────────────────────────
  function renderChip(g, compact = false) {
    const st      = gameStatus(g);
    const opp     = getOpponent(g);
    const home    = oriIsHome(g);
    const played  = st.state === 'final' || st.state === 'live';
    const off     = !isPlayedEntry(g);
    const sd      = off ? null : seriesMap.get(entryKey(g));
    const weather = st.state === 'scheduled' ? getGameWeather(g) : null;
    const probable  = st.state === 'scheduled' ? oriProbable(g) : null;
    const broadcast = off ? null : getBroadcast(g);
    const abbr    = oppAbbr(g);
    const haStr   = home ? 'vs' : '@';
    const logoSrc = `https://www.mlbstatic.com/team-logos/${opp.id}.svg`;
    const gameUrl = `https://www.mlb.com/gameday/${g.gamePk}`;
    const status  = chipStatus(g, st, compact);
    const isChanged = changed.has(g.gamePk);

    const chipClass = `sch-chip${home ? ' chip--home' : ''}${st.spring ? ' chip--spring' : ''}${status.cls}${isChanged ? ' chip--changed' : ''}${compact ? '' : ' sch-chip--full'}`;
    const label = [
      st.spring ? 'Spring training:' : '',
      `${home ? 'vs' : 'at'} ${opp.name ?? abbr}`,
      st.dhGame ? `(doubleheader game ${st.dhGame})` : '',
      `on ${shortDay(g._day)}.`,
      status.title,
      isChanged ? 'Changed since your last visit.' : '',
    ].filter(Boolean).join(' ');

    const badges = [
      st.spring ? '<span class="chip-tag chip-tag--spring">ST</span>' : '',
      st.dhGame ? `<span class="chip-tag" title="Doubleheader game ${st.dhGame}">DH${st.dhGame}</span>` : '',
    ].join('');
    const noteHtml = status.note ? `<div class="chip-note">${esc(status.note)}</div>` : '';
    const wxHtml = weather ? `<span class="chip-wx">${weather.emoji} ${weather.temp}°</span>` : '';

    if (compact) {
      const seriesBadge = sd && sd.total > 1
        ? `<span class="chip-series-badge" title="Game ${sd.gameNum} of ${sd.total}">G${sd.gameNum}/${sd.total}</span>`
        : '';
      return `<a class="${chipClass}" href="${esc(gameUrl)}" target="_blank" rel="noopener noreferrer" title="${esc(label)}" aria-label="${esc(label)}">
        <div class="chip-row1">
          <img class="chip-logo" src="${esc(logoSrc)}" alt="" width="18" height="18" loading="lazy" decoding="async">
          <span class="chip-ha">${haStr}</span>
          <span class="chip-abbr">${esc(abbr)}</span>
          ${badges}${seriesBadge}
        </div>
        <div class="chip-row2">${status.html}${wxHtml}</div>
        ${noteHtml}
      </a>`;
    }

    // Full chip for week view
    const seriesInfo = sd && sd.total > 1 ? `<span class="chip-series-info">Game ${sd.gameNum} of ${sd.total}</span>` : '';
    const springInfo = st.spring ? '<span class="chip-series-info">Spring training</span>' : '';
    const dhInfo     = st.dhGame ? `<span class="chip-series-info">Doubleheader, game ${st.dhGame}</span>` : '';
    const probHtml   = probable ? `<span class="chip-probable">${esc(probable)}</span>` : '';
    const bcastHtml  = broadcast ? `<span class="chip-broadcast">${esc(broadcast)}</span>` : '';
    const reasonHtml = off && st.reason ? `<span class="chip-series-info">${esc(st.reason)}</span>` : '';

    return `<a class="${chipClass}" href="${esc(gameUrl)}" target="_blank" rel="noopener noreferrer" aria-label="${esc(label)}">
      <div class="chip-full-header">
        <img class="chip-logo" src="${esc(logoSrc)}" alt="" width="24" height="24" loading="lazy" decoding="async">
        <div class="chip-full-matchup">
          <span class="chip-full-ha">${haStr} ${esc(opp.name ?? abbr)}</span>
          ${springInfo}${seriesInfo}${dhInfo}
        </div>
      </div>
      <div class="chip-full-status">${status.html}${wxHtml}</div>
      ${noteHtml}${reasonHtml ? `<div class="chip-full-meta">${reasonHtml}</div>` : ''}
      ${probHtml || bcastHtml ? `<div class="chip-full-meta">${probHtml}${bcastHtml}</div>` : ''}
    </a>`;
  }

  // Listings for one day: games in start order, the played game before a
  // postponement listed the same day
  function gamesOn(key) {
    return allGames
      .filter(g => g._day === key)
      .sort((a, b) => (isPlayedEntry(b) - isPlayedEntry(a)) || (new Date(a.gameDate) - new Date(b.gameDate)) || ((a.gameNumber ?? 1) - (b.gameNumber ?? 1)));
  }

  // ── Empty stretch note ────────────────────────────────────────
  // No games in view (the off-season): point to the next one
  function renderEmptyNote(fromKey, toKey, what) {
    const note = document.getElementById('schEmpty');
    const inView = allGames.some(g => g._day >= fromKey && g._day <= toKey);
    if (inView || !allGames.length) {
      note.hidden = true;
      return;
    }
    const next = allGames.filter(g => g._day > toKey && isPlayedEntry(g)).sort((a, b) => a._day.localeCompare(b._day))[0];
    const d = next ? new Date(`${next._day}T12:00:00`) : null;
    note.innerHTML = next
      ? `No games ${esc(what)}. Next: ${esc(gameStatus(next).spring ? 'spring training, ' : '')}${oriIsHome(next) ? 'vs' : '@'} ${esc(oppAbbr(next))} on ${esc(d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }))}. <button type="button" class="sch-today-btn" id="schJump">Go to ${esc(MONTHS[d.getMonth()])}</button>`
      : `No games ${esc(what)}. The next schedule hasn't been released yet.`;
    note.hidden = false;
    document.getElementById('schJump')?.addEventListener('click', () => {
      viewDate = d;
      render();
    });
  }

  // ── Month view ────────────────────────────────────────────────
  function renderMonth() {
    const year  = viewDate.getFullYear();
    const month = viewDate.getMonth();
    document.getElementById('schTitle').textContent = `${MONTHS[month]} ${year}`;
    const prefix = `${year}-${String(month+1).padStart(2,'0')}`;

    // First game of a series gets the opponent label above it
    const seriesFirstByDate = {};
    for (const g of allGames) {
      if (!g._day.startsWith(prefix)) continue;
      const sd = seriesMap.get(entryKey(g));
      if (sd?.isFirst && sd.total > 1) {
        seriesFirstByDate[g._day] = `${oriIsHome(g) ? 'vs' : '@'} ${oppAbbr(g)} (${sd.total}-game series)`;
      }
    }

    const today    = todayStr();
    const firstDow = new Date(year, month, 1).getDay();
    const daysInMo = new Date(year, month + 1, 0).getDate();

    let html = '<div class="cal-grid">';
    for (const d of DAYS_SHORT) html += `<div class="cal-hdr">${d}</div>`;
    for (let i = 0; i < firstDow; i++) html += '<div class="cal-cell cal-cell--empty"></div>';

    for (let day = 1; day <= daysInMo; day++) {
      const key   = `${prefix}-${String(day).padStart(2,'0')}`;
      const games = gamesOn(key);
      const isToday = key === today;
      const seriesLabel = seriesFirstByDate[key]
        ? `<span class="cal-series-label">${esc(seriesFirstByDate[key])}</span>`
        : '';

      html += `<div class="cal-cell${isToday ? ' cal-cell--today' : ''}${games.length ? ' cal-cell--game' : ''}">
        <span class="cal-day">${day}</span>
        ${keyMarkers(key)}
        ${seriesLabel}
        ${games.map(g => renderChip(g, true)).join('')}
      </div>`;
    }

    html += '</div>';
    document.getElementById('scheduleGrid').innerHTML = html;
    renderEmptyNote(`${prefix}-01`, `${prefix}-${String(daysInMo).padStart(2,'0')}`, `in ${MONTHS[month]}`);
  }

  // ── Week view ─────────────────────────────────────────────────
  function getWeekStart(ref) {
    const d = new Date(ref);
    d.setDate(d.getDate() - d.getDay());
    d.setHours(0, 0, 0, 0);
    return d;
  }

  function renderWeek() {
    const weekStart = getWeekStart(viewDate);
    const weekDays  = Array.from({ length: 7 }, (_, i) => {
      const d = new Date(weekStart);
      d.setDate(weekStart.getDate() + i);
      return d;
    });

    const s = weekDays[0].toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    const e = weekDays[6].toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    document.getElementById('schTitle').textContent = `${s} – ${e}`;

    const today = todayStr();
    let html = '<div class="week-grid">';

    for (const d of weekDays) {
      const key      = dateStr(d);
      const isToday  = key === today;
      const dayGames = gamesOn(key);
      const dayName  = d.toLocaleDateString('en-US', { weekday: 'short' });
      const dayNum   = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

      // Home or away that day, from the game actually played
      const lead = dayGames.find(isPlayedEntry);
      const stretchLabel = lead ? (oriIsHome(lead) ? '🏟 Home' : '✈ Away') : '';

      html += `<div class="week-col${isToday ? ' week-col--today' : ''}">
        <div class="week-col-hdr">
          <span class="week-day-name">${dayName}</span>
          <span class="week-day-num">${dayNum}</span>
          ${stretchLabel ? `<span class="week-stretch-label">${stretchLabel}</span>` : ''}
        </div>
        <div class="week-col-body">
          ${keyMarkers(key, true)}
          ${dayGames.length
            ? dayGames.map(g => renderChip(g, false)).join('')
            : (keysByDay[key] ? '' : '<span class="week-empty">—</span>')
          }
        </div>
      </div>`;
    }

    html += '</div>';
    document.getElementById('scheduleGrid').innerHTML = html;
    renderEmptyNote(dateStr(weekDays[0]), dateStr(weekDays[6]), 'this week');
  }

  // ── Render + Navigation ───────────────────────────────────────
  function render() {
    if (viewMode === 'month') renderMonth();
    else renderWeek();
  }

  document.getElementById('prevBtn').addEventListener('click', () => {
    if (viewMode === 'month') viewDate.setMonth(viewDate.getMonth() - 1, 1);
    else viewDate.setDate(viewDate.getDate() - 7);
    render();
  });

  document.getElementById('nextBtn').addEventListener('click', () => {
    if (viewMode === 'month') viewDate.setMonth(viewDate.getMonth() + 1, 1);
    else viewDate.setDate(viewDate.getDate() + 7);
    render();
  });

  document.getElementById('todayBtn').addEventListener('click', () => {
    viewDate = new Date();
    render();
  });

  document.querySelectorAll('.sch-view-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.sch-view-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      viewMode = btn.dataset.view;
      render();
    });
  });

  // ── Changes + freshness ───────────────────────────────────────
  // Games that moved since the last visit, each a button to its month
  function renderChanges() {
    const el = document.getElementById('schChanges');
    const games = [...changed].map(pk => {
      const listings = allGames.filter(g => g.gamePk === pk);
      return listings.find(isPlayedEntry) ?? listings[0];
    }).filter(Boolean).sort((a, b) => a._day.localeCompare(b._day));
    if (!games.length) {
      el.hidden = true;
      return;
    }
    const shown = games.slice(0, 4);
    el.innerHTML = `Changed since your last visit: ${shown.map((g, i) => {
      const st = gameStatus(g);
      const what = st.state === 'postponed' ? 'postponed'
        : st.state === 'cancelled' ? 'cancelled'
        : `now ${shortDay(g._day)}${st.timeTBD ? '' : `, ${new Date(g.gameDate).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })}`}`;
      return `<button type="button" class="sch-change-link" data-i="${i}">${oriIsHome(g) ? 'vs' : '@'} ${esc(oppAbbr(g))} ${esc(what)}</button>`;
    }).join(' · ')}${games.length > shown.length ? ` and ${games.length - shown.length} more, outlined on the calendar` : ''}.`;
    el.querySelectorAll('.sch-change-link').forEach(btn => btn.addEventListener('click', () => {
      viewDate = new Date(`${shown[Number(btn.dataset.i)]._day}T12:00:00`);
      render();
    }));
    el.hidden = false;
  }

  function renderUpdated() {
    const t = new Date(lastFetch).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
    document.getElementById('schUpdated').textContent = `Updated ${t}`;
  }

  // ── Load ──────────────────────────────────────────────────────
  // This season and the next: next year's spring training and opener show
  // up as soon as MLB releases them
  async function fetchSeason(season) {
    const url = `${MLB}/schedule?sportId=1&teamId=${TEAM_ID}&season=${season}`
      + `&gameType=S,R,F,D,L,W`
      + `&hydrate=team,linescore,decisions,probablePitcher(note),broadcasts(all),venue`
      + `&startDate=${season}-01-01&endDate=${season}-12-31`;
    const res = await fetch(url);
    if (!res.ok) throw new Error(`schedule ${season}: ${res.status}`);
    return flattenSchedule(await res.json());
  }

  async function loadSchedule() {
    const grid = document.getElementById('scheduleGrid');
    try {
      const [current, next, keys] = await Promise.allSettled([fetchSeason(SEASON), fetchSeason(SEASON + 1), keyDatesFor('schedule')]);
      indexKeyDates(keys.status === 'fulfilled' ? keys.value : []);
      if (current.status !== 'fulfilled') throw current.reason;
      allGames = [...current.value, ...(next.status === 'fulfilled' ? next.value : [])];
      lastFetch = Date.now();
      buildSeries(allGames);
      changed = changedSinceLastVisit(TEAM_ID, allGames);

      // Weather for scheduled games in the next 10 days
      const now     = Date.now();
      const tenDays = 10 * DAY_MS;
      const upcoming = allGames.filter(g => {
        const t = new Date(g.gameDate).getTime();
        return t > now - DAY_MS && t < now + tenDays && gameStatus(g).state === 'scheduled';
      });
      if (upcoming.length) await fetchWeatherForGames(upcoming).catch(() => {});

      render();
      renderChanges();
      renderUpdated();
    } catch {
      // A failed daily refresh keeps the schedule already on screen
      if (!allGames.length) grid.innerHTML = '<div class="sch-msg">Schedule unavailable — please try again later.</div>';
    }
  }

  // Once a day while the page stays open, and on coming back to a tab
  // that's been in the background past that
  const refreshIfStale = () => {
    if (!document.hidden && lastFetch && Date.now() - lastFetch >= DAY_MS) loadSchedule();
  };

  if (requireTeam()) {
    loadSchedule();
    setInterval(refreshIfStale, 60 * 60 * 1000);
    document.addEventListener('visibilitychange', refreshIfStale);
  }
</script>
