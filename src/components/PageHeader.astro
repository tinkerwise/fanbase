---
// Header for secondary pages: logo plus a "← Fanbase / Page" breadcrumb.
// teamPicker.js adds the team button to .header-right. Search and Settings
// are in More on phones (Layout.astro), so phones hide them here.
interface Props {
  current: string;
}
const { current } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <div class="header-inner">
    <a class="logo" href={base}>
      <img class="logo-img" src={`${base}logo.png`} alt="Fanbase logo" width="88" height="62" />
      <span class="logo-wordmark" aria-label="Fanbase">
        <span class="logo-word">Fan</span>
        <strong class="logo-word logo-word-accent">base</strong>
      </span>
    </a>
    <nav class="header-right header-breadcrumb" aria-label="Breadcrumb">
      <a class="breadcrumb-link" href={base}>← Fanbase</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <span class="breadcrumb-current">{current}</span>
    </nav>
    <button class="btn-search" type="button" aria-label="Search" title="Search (/ or ⌘K)" data-open-search><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
    <button class="btn-settings" type="button" aria-label="Settings" title="Settings" data-open-settings><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></button>
  </div>
</header>
